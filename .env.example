# Copy to .env.local. Never commit real keys.
# Vercel project root is the repository root.

# Absolute site origin used in canonical and Open Graph URLs.
SITE_URL=https://credexus.org

# Verified Resend sender, for example "Credexus <hello@credexus.org>".
RESEND_FROM=

# Inbox that receives introduction requests.
CONTACT_TO_EMAIL=hello@credexus.org

# Resend API key. If this or RESEND_FROM is missing, the form explains that
# and the build still succeeds.
RESEND_API_KEY=
